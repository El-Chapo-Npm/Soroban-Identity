PORT=3001
LOG_LEVEL=info
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ALGORITHMS=HS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=30
WEB3_STORAGE_TOKEN=
IPFS_ON_CHAIN_ENABLED=true

# Admin endpoint network allowlist (IPv4/IPv6 addresses or CIDR ranges).
# Production denies admin access until at least one range is configured.
ADMIN_IP_ALLOWLIST=
# Defaults to true in production; set false only during an explicit migration.
ADMIN_IP_ALLOWLIST_REQUIRED=

# Secret management (#757, #1294). Never commit tokens or values.
# Provider is "vault" (HashiCorp) or "doppler".
SECRETS_PROVIDER=vault
SECRETS_REFRESH_INTERVAL_SECONDS=
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_SECRET_PATH=secret/data/soroban-identity/development
VAULT_SECRET_PATHS=
VAULT_ROLE=
VAULT_JWT=
VAULT_REFRESH_INTERVAL_SECONDS=
VAULT_AUDIT_LOG_PATH=data/audit/secrets.ndjson
SECRET_MAPPINGS={"stellar_deploy_key":"STELLAR_SECRET_KEY","admin_api_key":"ADMIN_API_KEY","vc_proof_private_key":"VC_PROOF_PRIVATE_KEY","email_api_key":"EMAIL_API_KEY","db_primary_url":"DATABASE_URL","ipfs_api_key":"IPFS_API_KEY"}
DOPPLER_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=
DOPPLER_API_URL=https://api.doppler.com/v3/configs/config/secrets/download
# Optional Postgres connection string. When set, /health and /ready probe it.
DATABASE_URL=
SOROBAN_POOL_SIZE=4
SOROBAN_INVOKE_TIMEOUT_MS=10000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
IDENTITY_REGISTRY_CONTRACT_ID=
CREDENTIAL_MANAGER_CONTRACT_ID=
REPUTATION_CONTRACT_ID=
EVENT_POLL_INTERVAL_MS=3000
EXPIRY_CONCURRENCY=8
DID_CACHE_TTL_SECONDS=60
DID_CACHE_TTL_MS=60000
CACHE_CONTROL_MAX_AGE_SECONDS=60
REDIS_URL=
REDIS_MAX_RETRIES=5
REDIS_RETRY_BASE_MS=200
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_ENABLE_AUTO_RECONNECT=true
REDIS_RECONNECT_DELAY_MS=1000
DID_RESOLUTION_RATE_LIMIT_WINDOW_MS=60000
DID_RESOLUTION_RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_IP_PER_MINUTE=100
RATE_LIMIT_IP_BURST=0
RATE_LIMIT_USER_PER_MINUTE=1000
RATE_LIMIT_USER_BURST=0

# CORS — see server/README.md for the full reference
# Single origin, comma-separated list, or * (default: * in development, none in production)
CORS_ORIGIN=
# true/false — cannot be combined with CORS_ORIGIN=*
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Request-ID,X-Actor,X-User-Tier,X-API-Version,X-Encryption-Session
CORS_EXPOSED_HEADERS=X-Request-ID,Content-Type,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,X-API-Version
# Seconds a browser may cache a preflight result; 0 disables caching
CORS_MAX_AGE=86400
# AES-GCM application-layer encryption for credential payloads (disabled by default).
PAYLOAD_ENCRYPTION_ENABLED=false
PAYLOAD_ENCRYPTION_SESSION_TTL_SECONDS=900
PAYLOAD_ENCRYPTION_ROTATION_GRACE_SECONDS=60
PAYLOAD_ENCRYPTION_SENSITIVE_FIELDS=credentialSubject,claims,subject
# WebSocket real-time updates — see server/README.md for the full reference
WS_ENABLED=true
WS_PATH=/ws
WS_MESSAGE_LIMIT=60
WS_MESSAGE_WINDOW_MS=60000
# 0 disables heartbeats
WS_HEARTBEAT_INTERVAL_MS=30000

# Origin DDoS controls. Keep disabled only when an edge policy protects this origin.
DDOS_PROTECTION_ENABLED=false
DDOS_WINDOW_MS=60000
DDOS_MAX_REQUESTS_PER_IP=120
DDOS_MAX_CONNECTIONS_PER_IP=20
DDOS_SUSPICIOUS_THRESHOLD=96
DDOS_CAPTCHA_ENABLED=false
DDOS_CAPTCHA_SECRET=
DDOS_CAPTCHA_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# ISO 3166-1 alpha-2 country codes, for example: KP,SY,IR
DDOS_BLOCKED_REGIONS=
# Query-result cache controls
QUERY_CACHE_ENABLED=true
QUERY_CACHE_DEFAULT_TTL_MS=5000
QUERY_CACHE_TTL_VOLATILE_MS=1000
QUERY_CACHE_TTL_STABLE_MS=60000
QUERY_CACHE_WARM_QUERIES=
REDIS_MAX_RETRIES=5
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_RETRY_BASE_MS=200

# Connected Accounts (#1249). Leave provider values blank to keep linking disabled.
# Set a high-entropy value of at least 32 bytes; rotating it invalidates active sessions.
ACCOUNT_LINKS_SESSION_SECRET=
ACCOUNT_LINKS_STORE_PATH=data/account-links.json
# Public frontend URL (HTTPS in production); verification tokens are carried in the URL fragment.
ACCOUNT_LINKS_APP_URL=
# GitHub OAuth app; callback URL must exactly match the app's configured callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# Existing provider-agnostic email HTTP transport (required for verified email linking).
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
