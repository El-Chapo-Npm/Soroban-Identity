PORT=3001
LOG_LEVEL=info

# Optional HashiCorp Vault integration (#757). Never commit tokens or values.
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_SECRET_PATH=secret/data/soroban-identity/development
VAULT_SECRET_PATHS=
VAULT_ROLE=
VAULT_JWT=
VAULT_REFRESH_INTERVAL_SECONDS=
VAULT_AUDIT_LOG_PATH=data/audit/vault.ndjson
VAULT_SECRET_MAPPINGS={"stellar_deploy_key":"STELLAR_SECRET_KEY","admin_api_key":"ADMIN_API_KEY","vc_proof_private_key":"VC_PROOF_PRIVATE_KEY","email_api_key":"EMAIL_API_KEY"}
SOROBAN_POOL_SIZE=4
SOROBAN_INVOKE_TIMEOUT_MS=10000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
IDENTITY_REGISTRY_CONTRACT_ID=
CREDENTIAL_MANAGER_CONTRACT_ID=
REPUTATION_CONTRACT_ID=
EVENT_POLL_INTERVAL_MS=3000
EXPIRY_CONCURRENCY=8
DID_CACHE_TTL_SECONDS=60
CACHE_CONTROL_MAX_AGE_SECONDS=60
REDIS_URL=
REDIS_MAX_RETRIES=5
REDIS_RETRY_BASE_MS=200
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_ENABLE_AUTO_RECONNECT=true
REDIS_RECONNECT_DELAY_MS=1000
DID_RESOLUTION_RATE_LIMIT_WINDOW_MS=60000
DID_RESOLUTION_RATE_LIMIT_MAX_REQUESTS=60

# CORS — see server/README.md for the full reference
# Single origin, comma-separated list, or * (default: * in development, none in production)
CORS_ORIGIN=
# true/false — cannot be combined with CORS_ORIGIN=*
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Request-ID,X-Actor,X-User-Tier,X-API-Version
CORS_EXPOSED_HEADERS=X-Request-ID,Content-Type,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,X-API-Version
# Seconds a browser may cache a preflight result; 0 disables caching
CORS_MAX_AGE=86400
# WebSocket real-time updates — see server/README.md for the full reference
WS_ENABLED=true
WS_PATH=/ws
WS_MESSAGE_LIMIT=60
WS_MESSAGE_WINDOW_MS=60000
# 0 disables heartbeats
WS_HEARTBEAT_INTERVAL_MS=30000

# Distributed Tracing with Jaeger (#714)
JAEGER_ENABLED=false
JAEGER_SERVICE_NAME=soroban-identity-server
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6832
# Sampler types: const, probabilistic, ratelimiting, remote
JAEGER_SAMPLER_TYPE=const
# For 'const': 1 = sample all traces, 0 = sample none
# For 'probabilistic': 0.0-1.0 (e.g., 0.1 = 10% sampling)
JAEGER_SAMPLER_PARAM=1
JAEGER_REPORTER_LOG_SPANS=false
JAEGER_REPORTER_FLUSH_INTERVAL=1000
